<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HurryUpDavid.Pages.GamePage"
    BackgroundColor="DarkGray">

    <Grid>
        <!-- Bouton de sortie en haut à droite -->
        <Button
            Style="{StaticResource ExitButtonStyle}"
            Clicked="OnExitClicked"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="10" />

        <!-- Conteneur principal -->
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="20">

            <!-- Cercle + Timer/Nom du joueur (tout est cliquable) -->
            <Grid
            WidthRequest="400"
            HeightRequest="400"
            HorizontalOptions="Center">
                <!-- Cercle (GraphicsView) -->
                <GraphicsView
                x:Name="GameCanvas"
                WidthRequest="400"
                HeightRequest="400"
                HorizontalOptions="Center"
                VerticalOptions="Center">
                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCircleTapped" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>

                <!-- Timer et nom du joueur (au centre du cercle, aussi cliquable) -->
                <VerticalStackLayout
                HorizontalOptions="Center"
                VerticalOptions="Center"
                Spacing="0">    
                    <VerticalStackLayout.GestureRecognizers>
                        <!-- Ajout du TapGestureRecognizer pour le centre -->
                        <TapGestureRecognizer Tapped="OnCircleTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label x:Name="TimerLabel"
                    FontSize="70"
                    FontAttributes="Bold"
                    HorizontalTextAlignment="Center"
                    TextColor="White" />
                        <Label x:Name="PlayerLabel"
                    FontSize="18"
                    HorizontalTextAlignment="Center"
                    TextColor="White" />    
                </VerticalStackLayout>
            </Grid>

            <!-- Bouton Pause/Reprise (sous le cercle) -->
            <Button
                x:Name="PauseResumeButton"
                Text="▶"  
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="Transparent"
                TextColor="White"
                BorderColor="Transparent"
                Clicked="OnPauseResumeClicked"
                HorizontalOptions="Center"
                FontSize="24" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>