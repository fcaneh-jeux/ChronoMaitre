<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="HurryUpDavid.Pages.TimeBankGamePage"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="#2F4F4F">
    <Grid>
        <HorizontalStackLayout ZIndex="10" HorizontalOptions="End" VerticalOptions="Start" Margin="10" Spacing="5">
            <Button x:Name="Maison" Text="⌂" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#4682B4" TextColor="White" FontSize="20" Clicked="OnHomeClicked"/>
            <Button x:Name="Exit" Text="✕" WidthRequest="40" HeightRequest="40" CornerRadius="20" BackgroundColor="#B22222" TextColor="White" FontSize="20" Clicked="OnExitClicked"/>
        </HorizontalStackLayout>
        <Grid RowDefinitions="Auto, Auto, Auto">

            <!-- Joueur actif -->
            <Border x:Name="CurrentPlayerBorder" StrokeThickness="0" Padding="20">
                <VerticalStackLayout x:Name="CurrentPlayerContainer" Grid.Row="0" HorizontalOptions="Center" VerticalOptions="Center" Spacing="0" Padding="20">
                    <Label x:Name="CurrentPlayerLabel" FontSize="36" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <Label x:Name="CurrentPlayerTimeLabel" FontSize="96" FontAttributes="Bold" HorizontalTextAlignment="Center"/>
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCurrentPlayerTapped"/>
                    </VerticalStackLayout.GestureRecognizers>
                </VerticalStackLayout>
            </Border>
            <!-- Liste des joueurs avec leur temps -->
            <VerticalStackLayout x:Name="PlayersStack" Grid.Row="1"  ZIndex="10" Spacing="10"  VerticalOptions="Start" HorizontalOptions="Center" Margin="0,20,0,20">
                <!-- Les joueurs seront ajoutés dynamiquement ici -->
            </VerticalStackLayout>
            <Button x:Name="PauseResumeButton" Grid.Row="2" Text="▶" FontSize="60" WidthRequest="90" HeightRequest="90" CornerRadius="45" BackgroundColor="Transparent" TextColor="White" Clicked="OnPauseResumeClicked" HorizontalOptions="Center" Margin="0,20,0,20"/>
        </Grid>
    </Grid>
</ContentPage>