<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HurryUpDavid.Pages.GamePage"
    NavigationPage.HasBackButton="False"
    BackgroundColor="DarkGray">

    <Grid>
        <!-- Bouton de sortie en haut à droite -->
        <Button
            x:Name="ExitButton"
            Text="✕"
            WidthRequest="40"
            HeightRequest="40"
            CornerRadius="20"
            BackgroundColor="Transparent"
            TextColor="White"
            FontSize="20"
            Clicked="OnExitClicked"
            Grid.Row="0"
            Grid.Column="1"
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="10" />

        <!-- Conteneur principal -->
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="20">

            <!-- Cercle + Timer/Nom du joueur -->
            <Grid
                WidthRequest="400"
                HeightRequest="400"
                HorizontalOptions="Center">
                <!-- Cercle (GraphicsView) -->
                <GraphicsView
                    x:Name="GameCanvas"
                    WidthRequest="400"
                    HeightRequest="400"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCircleTapped" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>

                <!-- Timer et nom du joueur (au centre du cercle) -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCircleTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label
                        x:Name="TimerLabel"
                        FontSize="70"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="White" />
                    <Label
                        x:Name="PlayerLabel"
                        FontSize="18"
                        HorizontalTextAlignment="Center"
                        TextColor="White" />
                </VerticalStackLayout>
            </Grid>

            <!-- Bouton Pause/Reprise (sous le cercle) -->
            <Button
                x:Name="PauseResumeButton"
                Text="▶"
                WidthRequest="60"
                HeightRequest="60"
                CornerRadius="30"
                BackgroundColor="Transparent"
                TextColor="White"
                Clicked="OnPauseResumeClicked"
                HorizontalOptions="Center"/>
        </VerticalStackLayout>
    </Grid>
</ContentPage>