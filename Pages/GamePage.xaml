<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HurryUpDavid.Pages.GamePage"
    NavigationPage.HasBackButton="False"
    BackgroundColor="#2F4F4F">

    <Grid>
        <!-- Bouton en haut à droite -->
        <HorizontalStackLayout
            HorizontalOptions="End"
            VerticalOptions="Start"
            Margin="10"
            Spacing="5">

            <Button
                Text="⌂"
                WidthRequest="40"
                HeightRequest="40"
                CornerRadius="20"
                BackgroundColor="#4682B4"
                TextColor="White"
                FontSize="20"
                Clicked="OnHomeClicked"/>

            <Button
                Text="✕"
                WidthRequest="40"
                HeightRequest="40"
                CornerRadius="20"
                BackgroundColor="#B22222"
                TextColor="White"
                FontSize="20"
                Clicked="OnExitClicked"/>   

        </HorizontalStackLayout>

        <!-- Conteneur principal -->
        <VerticalStackLayout
            Grid.Row="1"
            HorizontalOptions="Center"
            VerticalOptions="Center"
            Spacing="20">

            <!-- Cercle + Timer/Nom du joueur -->
            <Grid
                WidthRequest="500"
                HeightRequest="500"
                HorizontalOptions="Center">
                <!-- Cercle (GraphicsView) -->
                <GraphicsView
                    x:Name="GameCanvas"
                    WidthRequest="500"
                    HeightRequest="500"
                    HorizontalOptions="Center"
                    VerticalOptions="Center">
                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCircleTapped" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>

                <!-- Timer et nom du joueur (au centre du cercle) -->
                <VerticalStackLayout
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Spacing="0">
                    <VerticalStackLayout.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCircleTapped" />
                    </VerticalStackLayout.GestureRecognizers>
                    <Label
                        x:Name="TimerLabel"
                        FontSize="110"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#F5F5F5" />
                    <Label
                        x:Name="PlayerLabel"
                        FontSize="24"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center"
                        TextColor="#D3D3D3" />
                </VerticalStackLayout>
            </Grid>

            <!-- Bouton Pause/Reprise (sous le cercle) -->
            <Button
                x:Name="PauseResumeButton"
                Text="▶"
                FontSize="90"
                WidthRequest="120"
                HeightRequest="120"
                CornerRadius="60"
                BackgroundColor="#4682B4"
                TextColor="White"
                Clicked="OnPauseResumeClicked"
                HorizontalOptions="Center">
                <Button.Shadow>
                    <Shadow
                        Brush="Black"
                        Offset="3,3"
                        Opacity="0.3"
                        Radius="5" />
                </Button.Shadow>
            </Button>
        </VerticalStackLayout>
    </Grid>
</ContentPage>