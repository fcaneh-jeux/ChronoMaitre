<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HurryUpDavid.Pages.SetupPage">

    <VerticalStackLayout
        Padding="30"
        Spacing="20">

        <Label
            Text="Hurry Up David"
            FontSize="32"
            HorizontalOptions="Center" />

        <Label
            Text="Nombre de joueurs" />

        <Entry
            x:Name="PlayersEntry"
            Keyboard="Numeric"
            Text="4" />

        <Label
            Text="Temps par tour (secondes)" />

        <Entry
            x:Name="TimeEntry"
            Keyboard="Numeric"
            Text="90" />

        <Button
            Text="Démarrer"
            Clicked="OnStartClicked" />

    </VerticalStackLayout>

</ContentPage>