<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HurryUpDavid.Pages.GamePage">

    <VerticalStackLayout Padding="20">

        <Label
            Text="Game Page"
            FontSize="30"
            HorizontalOptions="Center" />

        <Label Text="{Binding PlayerCount}" FontSize="30" HorizontalOptions="Center" />
        <Label Text="{Binding TurnDuration}" FontSize="30" HorizontalOptions="Center" />

    </VerticalStackLayout>

</ContentPage>