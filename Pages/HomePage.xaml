<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="HurryUpDavid.Pages.HomePage"
    NavigationPage.HasNavigationBar="False"
    BackgroundColor="#2F4F4F">

    <VerticalStackLayout
        VerticalOptions="Center"
        HorizontalOptions="Center"
        Spacing="30"
        Padding="30">

        <Label
            Text="⏳ Hurry Up David"
            FontSize="36"
            FontAttributes="Bold"
            TextColor="White"
            HorizontalTextAlignment="Center" />

        <Label
            Text="Choisissez un mode de jeu"
            FontSize="18"
            TextColor="#D3D3D3"
            HorizontalTextAlignment="Center" />

        <Button
            Text="⏱ Temps par tour"
            WidthRequest="280"
            HeightRequest="70"
            CornerRadius="15"
            BackgroundColor="#4682B4"
            TextColor="White"
            FontSize="20"
            Clicked="OnTurnTimerClicked"/>

        <Button
            Text="🏦 Banque de temps"
            WidthRequest="280"
            HeightRequest="70"
            CornerRadius="15"
            BackgroundColor="#008B8B"
            TextColor="White"
            FontSize="20"
            Clicked="OnTimeBankClicked"/>

        <Label
            Text="Version 2.0"
            FontSize="12"
            TextColor="LightGray"
            HorizontalTextAlignment="Center"/>

    </VerticalStackLayout>

</ContentPage>